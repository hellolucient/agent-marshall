# OpenAI
OPENAI_API_KEY=sk-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# X (Twitter) — optional; if unset, only drafts are created
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Dashboard login (protects /dashboard). Set in production; leave empty locally to skip login.
DASHBOARD_PASSWORD=

# Vercel Cron only (Bearer). Separate from dashboard password. Manual heartbeat uses your login cookie.
CRON_SECRET=

# Optional: RSS / research sources (comma-separated feed URLs)
RESEARCH_RSS_FEEDS=

# Optional: X recent search queries (comma-separated; no commas inside a single query). Needs X_API_*; often paid tier.
# Marshall-aligned: hallucinations, calibration, epistemology, cognition (tweak anytime).
RESEARCH_TWITTER_QUERIES=AI hallucination -filter:retweets min_faves:3 lang:en,LLM calibration confidence,AI epistemology truth,language model overconfident,ChatGPT wrong confident,LLM reasoning limits,AI interpretability alignment,hallucination metaphor AI,AI cognition human thinking,LLM verification factuality,reasoning model failure,stochastic parrot discourse
# RESEARCH_TWITTER_MAX_PER_QUERY=25   # 10|25|50|100 per query (each query = 1 API call per heartbeat)

# Optional: fewer swarm ideas = faster local cron (default 5; each idea = 5 LLM calls)
# HEARTBEAT_SWARM_LIMIT=2
