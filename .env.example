# OpenAI
OPENAI_API_KEY=sk-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# X (Twitter) — OAuth 1.0a USER context (same user posts + search + reply)
# POST /2/tweets needs Read + Write on the app + tokens created AFTER Write was enabled.
# If publish returns 403: Developer Portal → app → User auth → App permissions → Read and write
# → Keys and tokens → Regenerate Access Token & Secret → paste into X_ACCESS_* below → restart dev.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

DASHBOARD_PASSWORD=
CRON_SECRET=

RESEARCH_RSS_FEEDS=

# Twitter search = $ per tweet read. DEFAULTS ARE LEAN:
# - Heartbeat does NOT search X (no surprise bills). Manual "Refresh" on Reply targets only.
# - Each refresh: 1 query × 10 tweets (~10 reads). Raise only if you need more.
RESEARCH_TWITTER_QUERIES=AI hallucination
RESEARCH_TWITTER_MAX_QUERIES_PER_RUN=1
RESEARCH_TWITTER_MAX_PER_QUERY=10
# RESEARCH_TWITTER_ON_HEARTBEAT=true   # optional: daily cron also pulls tweets (costly)

# Swarm scores this many newest candidate ideas per daily run (≥ tweet drafts you want).
# HEARTBEAT_SWARM_LIMIT=5
# Tweet drafts after swarm (default 5).
# DAILY_TWEET_DRAFT_LIMIT=5
#
# DB: reply drafts use table reply_drafts (run memory/reply-drafts-table.sql once if upgrading).
